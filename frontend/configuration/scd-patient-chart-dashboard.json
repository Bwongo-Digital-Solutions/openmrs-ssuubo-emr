{
  "@openmrs/esm-patient-chart-app": {
    "extensionSlots": {

      "patient-chart-dashboard-slot": {
        "add": [
          "nav-group#SickleCellCareTreatment"
        ],
        "configure": {
          "nav-group#SickleCellCareTreatment": {
            "title": "sickleCellCareAndTreatment",
            "slotName": "sickle-cell-care-and-treatment-group-slot",
            "isExpanded": true,
            "translationOverrides": {
              "en": {
                "sickleCellCareAndTreatment": "Sickle Cell Care & Treatment"
              }
            }
          }
        }
      },

      "sickle-cell-care-and-treatment-group-slot": {
        "add": [
          "dashboard#scd-general-info"
        ],

        "order": [
          "dashboard#scd-general-info"
        ],

        "configure": {
          "dashboard#scd-general-info": {
            "title": "generalInformation",
            "path": "scd-general-info",
            "slot": "scd-general-info-dashboard-slot",
            "translationOverrides": {
              "en": {
                "generalInformation": "General Information"
              }
            }
          }
        }
      },
      "scd-general-info-dashboard-slot": {
        "add": ["scd-general-info-dashboard"]
      }

    }
  }
}