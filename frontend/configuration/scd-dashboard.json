{
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": true,
    "extensionSlots": {
      "action-menu-patient-chart-items-slot": {
        "order": ["order-basket-action-menu"]
      },
      "patient-chart-dashboard-slot": {
        "add": [
          "nav-group#SickleCellCareTreatment"
        ],
        "configure": {
          "nav-group#SickleCellCareTreatment": {
            "title": "Sickle Cell Care And Treatment",
            "slotName": "sickle-cell-care-and-treatment-group-slot",
            "isExpanded": true,
            "translationOverrides": {
              "en": {
                "Sickle Cell Care And Treatment": "Sickle Cell Care & Treatment"
              }
            }
          }
        }
      },

      "sickle-cell-care-and-treatment-group-slot": {
        "add": [
          "dashboard#scd-general-info"
        ],

        "order": [
          "dashboard#scd-general-info"
        ],

        "configure": {
          "dashboard#scd-general-info": {
            "title": "General Information",
            "path": "scd-general-info",
            "slot": "scd-general-info-dashboard-slot"
          }
        }
      },
      "scd-general-info-dashboard-slot": {
        "add": ["scd-general-info-dashboard"]
      }
      
      
    },
    "patient-chart-summary-dashboard-slot": [
      "@openmrs/esm-patient-allergies-app.patient-allergies-summary"
    ],
    "logo": {
      "src": "/openmrs/spa/logo.png",
      "alt": "Patient Chart Logo",
      "name": "Ssubo SCD Clinic"
    },
    "patientSummary": {
      "sections": [
        "patient-allergies-header",
        "patient-conditions-header",
        "patient-notes-header"
      ]
    },
    "clinicalViews": [
      {
        "id": "scd-dashboard",
        "name": "SCD",
        "title": "Sickle Cell Disease",
        "slot": "scd-dashboard-slot",
        "widgets": [
          {
            "id": "scd-encounters-widget",
            "name": "SCD Consultations",
            "encounterType": "dd528487-82a5-4082-9c72-ed246bd49591",
            "formList": [
              {
                "name": "SSUUBO Sickle Cell Disease Form",
                "uuid": "3f2a1b4c-7d8e-4f9a-b2c3-d4e5f6a7b8c9"
              }
            ]
          }
        ]
      }
    ]
  }
}