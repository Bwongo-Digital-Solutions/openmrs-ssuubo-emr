{
  "dashboards": [
    {
      "name": "Ssuubo SCD",
      "path": "ssuubo-scd",
      "icon": "omrs-icon-virus",
      "layout": "one-column",
      "slots": {
        "main": "ssuubo-scd-dashboard-slot",
        "ssuubo-scd-dashboard-slot": {
        "extensions": [
        "ssuubo-scd-registration",
        "ssuubo-scd-clinic-visit",
        "ssuubo-scd-crisis",
        "ssuubo-scd-summary"
         ]
        }
      },
      "extensions": {
    "ssuubo-scd-registration": {
      "component": "patient-form-entry-link",
      "label": "Register SCD Patient",
      "formUuid": "SCD-REGISTRATION-FORM-UUID"
    },

    "ssuubo-scd-clinic-visit": {
      "component": "patient-form-entry-link",
      "label": "SCD Clinic Visit",
      "formUuid": "SCD-CLINIC-VISIT-FORM-UUID"
    },

    "ssuubo-scd-crisis": {
      "component": "patient-form-entry-link",
      "label": "Record Crisis Episode",
      "formUuid": "SCD-CRISIS-FORM-UUID"
    },

    "ssuubo-scd-summary": {
      "component": "obs-summary-widget",
      "label": "SCD Summary"
    }
    }
    }
  ]
}